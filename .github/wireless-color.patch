+// Tint the radios and their networks the way firewall zones tint interfaces
+const wifiColors = { radioSat: 75, radioLight: 80, netSat: 75, netLight: 80, netSpread: 40, lightModeBoost: 25, stripe: 17 };
+
+// One tint for both views, filling the overview badge and striping the station one
+const wifi_tint = hsl => `linear-gradient(hsl(${hsl} / .4), hsl(${hsl} / .3))`;
+const wifi_fill = hsl => hsl ? `background:${wifi_tint(hsl)}` : '';
+const wifi_stripe = hsl => hsl ? `background:${wifi_tint(hsl)} bottom/100% ${wifiColors.stripe}px no-repeat` : '';
+
+// Map the section names to colors, radios spread over the wheel, nets beside them
+function wifi_colors(radios, wifiNets) {
+	// The pale tints wash out on the light theme
+	const boost = s => (document.documentElement.getAttribute('data-darkmode') == 'true') ? s : Math.min(s + wifiColors.lightModeBoost, 100);
+	const color = (hue, sat, light) => `${hue} ${sat}% ${light}%`;
+	const byName = (a, b) => (a.getName() > b.getName()) ? 1 : -1;
+	const devices = (radios ?? []).slice().sort(byName);
+	const styles = {};
+
+	devices.forEach((radio, n) => {
+		const hue = 30 + n * 360 / devices.length;
+
+		styles[radio.getName()] = color(hue, boost(wifiColors.radioSat), wifiColors.radioLight);
+
+		(wifiNets ?? []).filter(net => net.getWifiDeviceName() == radio.getName()).sort(byName).forEach((net, i) => {
+			// 0, +1, -1, +2, -2 … keeps a network in the hue family of its radio
+			const offset = ((i + 1) >> 1) * wifiColors.netSpread * ((i % 2) ? 1 : -1);
+
+			styles[net.getName()] = color(hue + offset, boost(wifiColors.netSat), wifiColors.netLight);
+		});
+	});
+
+	return styles;
+}
